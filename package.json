{
	"name": "obsidian-replay",
	"version": "1.0.2",
	"description": "Record, replay, and export the writing process in Obsidian notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsc --project tsconfig.test.json && node scripts/test.mjs",
		"version": "node version-bump.mjs",
		"lint": "eslint . --max-warnings 0",
		"check:release": "node scripts/check-release.mjs"
	},
	"keywords": [],
	"license": "0BSD",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
